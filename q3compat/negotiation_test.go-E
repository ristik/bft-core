package q3compat

import (
	"errors"
	"testing"

	"github.com/stretchr/testify/require"
	"github.com/unicitynetwork/bft-core/network/protocol/handshake"
	abcrypto "github.com/unicitynetwork/bft-go-base/crypto"
	"github.com/unicitynetwork/bft-go-base/types"
)

type negFixture struct {
	signer abcrypto.Signer
	exp    Expectation
	id     Identity
	sess   Session
}

func newNeg(t *testing.T) negFixture {
	t.Helper()
	signer, key := newSigner(t)
	id := Identity{Epoch: 3, BodyID: fill(1), ActivationID: fill(2), Config: fill(3)}
	return negFixture{signer: signer, id: id,
		sess: Session{Challenge: fill(7)[:], Signer: "peerA", Verifier: "peerB"},
		exp: Expectation{Role: RoleRoot, Network: testNetwork, Genesis: fill(9), Protocol: "q3/1", Installed: id,
			KeyOf: func(r Role, n string) ([]byte, bool) { return key, r == RoleRoot && n == "n1" }}}
}

func (f negFixture) hello(t *testing.T, mut func(*Hello)) *Hello {
	t.Helper()
	h, err := NewHello(RoleRoot, testNetwork, fill(9), "q3/1", f.id, "n1", f.sess, f.signer)
	require.NoError(t, err)
	if mut != nil {
		mut(&h)
	}
	return &h
}

func TestVerifyHello(t *testing.T) {
	f := newNeg(t)
	adm, err := f.exp.Verify(f.hello(t, nil), f.sess)
	require.NoError(t, err, "acceptance control")
	require.Equal(t, Live, adm)

	other, _ := newSigner(t)
	resign := func(h *Hello, s Session) { // a correctly signed hello with the fields as mutated
		sig, err := other.SignBytes(h.message(s))
		require.NoError(t, err)
		h.Signature = sig
	}
	_ = resign
	cases := []struct {
		name string
		h    func() *Hello
		s    Session
		want error
	}{
		{"no hello", func() *Hello { return nil }, f.sess, ErrLegacyPeer},
		{"legacy protocol", func() *Hello { return f.hello(t, func(h *Hello) { h.Protocol = "q3/0" }) }, f.sess, ErrProtocol},
		{"empty protocol", func() *Hello { return f.hello(t, func(h *Hello) { h.Protocol = "" }) }, f.sess, ErrProtocol},
		{"other network", func() *Hello { return f.hello(t, func(h *Hello) { h.Network++ }) }, f.sess, ErrChain},
		{"other genesis", func() *Hello { return f.hello(t, func(h *Hello) { h.Genesis = fill(8)[:] }) }, f.sess, ErrChain},
		{"other role", func() *Hello { return f.hello(t, func(h *Hello) { h.Role = RoleShard }) }, f.sess, ErrRole},
		{"unknown node", func() *Hello { return f.hello(t, func(h *Hello) { h.NodeID = "n9" }) }, f.sess, ErrUnknownPeer},
		{"tampered after signing", func() *Hello { return f.hello(t, func(h *Hello) { h.Epoch++ }) }, f.sess, ErrHelloSignature},
		{"signed by another key", func() *Hello { return f.hello(t, func(h *Hello) { resign(h, f.sess) }) }, f.sess, ErrHelloSignature},
		{"replayed on another challenge", func() *Hello { return f.hello(t, nil) }, Session{fill(6)[:], "peerA", "peerB"}, ErrHelloSignature},
		{"replayed from another sender", func() *Hello { return f.hello(t, nil) }, Session{f.sess.Challenge, "peerC", "peerB"}, ErrHelloSignature},
		{"relayed to another verifier", func() *Hello { return f.hello(t, nil) }, Session{f.sess.Challenge, "peerA", "peerC"}, ErrHelloSignature},
	}
	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			_, err := f.exp.Verify(tc.h(), tc.s)
			require.ErrorIs(t, err, tc.want)
		})
	}
}

func TestVerifyHelloConfiguration(t *testing.T) {
	f := newNeg(t)
	for name, mut := range map[string]func(*Identity){
		"other epoch":      func(i *Identity) { i.Epoch++ },
		"other body":       func(i *Identity) { i.BodyID = fill(0xa) },
		"other activation": func(i *Identity) { i.ActivationID = fill(0xb) },
		"other tuple":      func(i *Identity) { i.Config = fill(0xc) },
	} {
		t.Run(name, func(t *testing.T) {
			g := f
			mut(&g.id) // the peer is correctly authenticated and claims a different installed configuration
			_, err := f.exp.Verify(g.hello(t, nil), f.sess)
			require.ErrorIs(t, err, ErrConfiguration)
		})
	}
}

func TestLaggingPeerIsHistoricalOnly(t *testing.T) {
	f := newNeg(t)
	past := Identity{Epoch: 2, BodyID: fill(4), ActivationID: fill(5), Config: fill(6)}
	f.exp.Past = func(e uint64) (Identity, bool) { return past, e == 2 }
	lag := f
	lag.id = past
	adm, err := f.exp.Verify(lag.hello(t, nil), f.sess)
	require.NoError(t, err)
	require.Equal(t, Historical, adm, "a verified past epoch is admitted for retrieval only, never live")

	forged := lag
	forged.id.BodyID = fill(0xd) // claims epoch 2 with a body that is not epoch 2's
	_, err = f.exp.Verify(forged.hello(t, nil), f.sess)
	require.ErrorIs(t, err, ErrConfiguration)

	ahead := f
	ahead.id.Epoch = 4 // a future epoch is never historical
	f.exp.Past = func(uint64) (Identity, bool) { return ahead.id, true }
	_, err = f.exp.Verify(ahead.hello(t, nil), f.sess)
	require.ErrorIs(t, err, ErrConfiguration)
}

func TestHelloCodec(t *testing.T) {
	f := newNeg(t)
	raw, err := f.hello(t, nil).Encode()
	require.NoError(t, err)
	h, err := DecodeHello(raw)
	require.NoError(t, err)
	_, err = f.exp.Verify(&h, f.sess)
	require.NoError(t, err, "a hello survives the wire")

	// What an old peer sends is the existing handshake; it is not a hello.
	old, err := types.Cbor.Marshal(handshake.Handshake{PartitionID: 1, NodeID: "n1"})
	require.NoError(t, err)
	_, err = DecodeHello(old)
	require.ErrorIs(t, err, ErrLegacyPeer)

	for name, raw := range map[string][]byte{"empty": nil, "oversize": make([]byte, maxHello+1), "not cbor": {0xff, 0x00}} {
		_, err := DecodeHello(raw)
		require.ErrorIs(t, err, ErrLegacyPeer, name)
	}
	for name, mut := range map[string]func(*Hello){
		"version":    func(h *Hello) { h.Version = 2 },
		"genesis":    func(h *Hello) { h.Genesis = h.Genesis[:31] },
		"body":       func(h *Hello) { h.BodyID = nil },
		"activation": func(h *Hello) { h.ActivationID = append(h.ActivationID, 0) },
		"config":     func(h *Hello) { h.Config = nil },
		"node id":    func(h *Hello) { h.NodeID = string(make([]byte, maxText+1)) },
		"protocol":   func(h *Hello) { h.Protocol = string(make([]byte, maxText+1)) },
		"signature":  func(h *Hello) { h.Signature = make([]byte, maxSig+1) },
	} {
		raw, err := f.hello(t, mut).Encode()
		require.NoError(t, err)
		_, err = DecodeHello(raw)
		require.True(t, errors.Is(err, ErrLegacyPeer), name)
	}
}
