[Unit]
Description=Publish NB2 B1 checkpoint for testnet generation %i
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nb2-origin/%i.conf
ExecStart=/usr/bin/python3 ${NB2_EXPORTER} /srv/testnet/%i ${NB2_RELEASE_DIR} ${NB2_RELEASE_SHA256} $NB2_RPC_ARGS
TimeoutStartSec=45
NoNewPrivileges=true
PrivateTmp=true
