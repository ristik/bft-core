# Prometheus configuration for one lane or one host running validators 1..N (VT-12). Rendered by scripts/vt12-monitoring.sh; the `validator`
# label is what the alert rules and the dashboard join on. Replace the targets with your own hosts and ports.
global:
  scrape_interval: 5s
  evaluation_interval: 5s
rule_files:
  - /etc/prometheus/validator-alerts.yml
scrape_configs:
@SCRAPES@
