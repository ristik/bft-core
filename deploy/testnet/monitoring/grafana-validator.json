{
 "uid": "unicity-validator",
 "title": "Unicity validator",
 "tags": [
  "unicity",
  "validator"
 ],
 "schemaVersion": 39,
 "version": 1,
 "refresh": "15s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "DS",
    "type": "datasource",
    "query": "prometheus",
    "label": "Datasource"
   },
   {
    "name": "validator",
    "type": "query",
    "label": "Validator",
    "datasource": {
     "type": "prometheus",
     "uid": "${DS}"
    },
    "query": {
     "query": "label_values(unicity_build_info, validator)",
     "refId": "v"
    },
    "refresh": 2,
    "sort": 1
   }
  ]
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Validator",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "collapsed": false,
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Status verdict",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "unicity_vr_status_verdict{validator=\"$validator\"}",
     "legendFormat": "verdict",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 2
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "ok"
        },
        "1": {
         "text": "warning"
        },
        "2": {
         "text": "critical"
        },
        "3": {
         "text": "unknown"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 3,
   "type": "stat",
   "title": "PoA state",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "unicity_vr_identity_state{validator=\"$validator\"}",
     "legendFormat": "state",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "None"
        },
        "1": {
         "text": "Applied"
        },
        "2": {
         "text": "Admitted"
        },
        "3": {
         "text": "Joining"
        },
        "4": {
         "text": "Active"
        },
        "5": {
         "text": "ExitRequested"
        },
        "6": {
         "text": "Removing"
        },
        "7": {
         "text": "Leaving"
        },
        "8": {
         "text": "Exited"
        },
        "9": {
         "text": "Parked"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Committee member",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "unicity_vr_identity_member{validator=\"$validator\"}",
     "legendFormat": "VR committee",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     }
    },
    {
     "refId": "B",
