     "legendFormat": "root follows as member",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {}
  },
