# Host nginx HTTP context. Replace hostnames and TLS paths before nginx -t.
limit_req_zone $binary_remote_addr zone=tn_rpc:10m rate=5r/s;
limit_req_zone $binary_remote_addr zone=tn_agg:10m rate=10r/s;   # the aggregator route's own (the gateway's 10/s per address); a location's limit_req replaces the server's
limit_conn_zone $binary_remote_addr zone=tn_conn:10m;
server {
    listen 443 ssl;
    server_name rpc.testnet.example;
    ssl_certificate /etc/letsencrypt/live/rpc.testnet.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rpc.testnet.example/privkey.pem;
    client_max_body_size 16k;
    client_body_timeout 5s;
    limit_conn tn_conn 4;
    limit_req zone=tn_rpc burst=10 nodelay;
    limit_req_status 429;
    location = / {
        limit_except POST { deny all; }
        # the gateway allows 16 KiB per method except eth_sendRawTransaction, eth_call and eth_estimateGas (4.5 MiB: a bridge redemption and its
        # call and estimate); it checks the method itself
        client_max_body_size 5m;
        client_body_timeout 30s;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Host $host;
        proxy_connect_timeout 2s;
        proxy_read_timeout 45s;
        proxy_send_timeout 30s;
        proxy_pass http://127.0.0.1:8545;
    }
    # the aggregator (the gateway's /aggregator route: the SDK's JSON-RPC methods only, 64 KiB, its own rate limit) and its trust-base pages
    location = /aggregator {
        limit_except POST { deny all; }
        limit_req zone=tn_agg burst=20 nodelay;
        client_max_body_size 64k;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Host $host;
        proxy_connect_timeout 2s;
        proxy_read_timeout 35s;
        proxy_send_timeout 10s;
        proxy_pass http://127.0.0.1:8545;
    }
    location = /api/v1/trustbases {
        limit_except GET { deny all; }
        limit_req zone=tn_agg burst=20 nodelay;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Host $host;
        proxy_connect_timeout 2s;
        proxy_read_timeout 35s;
        proxy_pass http://127.0.0.1:8545;
    }
    location / { return 404; }
}
# Install faucet/nginx.conf.example separately for the faucet hostname/8088.
# Only 443 (and 80 for certificate renewal) should be opened in the host firewall.
