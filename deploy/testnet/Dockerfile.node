# Linux binaries built from pins.json, verified by build-images.py before packaging.
FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 libssl3 ca-certificates && rm -rf /var/lib/apt/lists/*
COPY ubft unicity-reth rugregator /usr/local/bin/
USER 10001:10001
ENTRYPOINT ["ubft"]
